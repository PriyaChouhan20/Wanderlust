<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="form-card-container text-center">
            <div class="form-header-icon bg-danger-subtle text-danger mx-auto mb-3">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h3 class="fw-bold mb-2">Something went wrong</h3>
            <p class="text-secondary mb-4"><%= typeof message !== 'undefined' && message ? message : "An unexpected error occurred." %></p>
            <a href="/listings" class="btn btn-primary-custom px-4 py-2">
                <i class="fa-solid fa-arrow-left me-1"></i> Return to Listings
            </a>
        </div>
    </div>
</div>
