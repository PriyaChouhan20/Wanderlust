<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center mt-2 mb-5">
    <div class="col-12 col-md-10 col-lg-8 col-xl-7">
        <div class="form-card-container">
            
            <!-- Form Header -->
            <div class="form-header">
                <div class="form-header-icon">
                    <i class="fa-solid fa-pen-to-square"></i>
                </div>
                <h2>Edit Your Listing</h2>
                <p>Update information, pricing, or media for this property</p>
            </div>

            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=PUT"
                novalidate
                class="needs-validation"
            >
                <!-- Title -->
                <div class="mb-3">
                    <label for="title" class="form-label">Property Title</label>
                    <input
                        name="listing[title]"
                        id="title"
                        value="<%= listing.title %>"
                        type="text"
                        class="form-control"
                        required
                    />
                    <div class="invalid-feedback">Please enter a title.</div>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea
                        name="listing[description]"
                        id="description"
                        rows="4"
                        class="form-control"
                        required
                    ><%= listing.description %></textarea>
                    <div class="invalid-feedback">Please enter a description.</div>
                </div>

                <!-- Current Image Preview & URL -->
                <% if (listing.image && listing.image.url) { %>
                    <div class="mb-3">
                        <label class="form-label">Current Image Preview</label>
                        <div class="preview-img-box">
                            <img src="<%= listing.image.url %>" alt="<%= listing.title %>" />
                        </div>
                    </div>
                <% } %>

                <div class="mb-3">
                    <label for="image" class="form-label">Image URL</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fa-regular fa-image text-secondary"></i></span>
                        <input
                            name="listing[image][url]"
                            id="image"
                            value="<%= listing.image ? listing.image.url : '' %>"
                            type="text"
                            class="form-control"
                            placeholder="https://images.unsplash.com/..."
                        />
                    </div>
                </div>

                <!-- Price & Category -->
                <div class="row">
                    <div class="col-12 col-md-6 mb-3">
                        <label for="price" class="form-label">Price per night (&#8377;)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">&#8377;</span>
                            <input
                                name="listing[price]"
                                id="price"
                                value="<%= listing.price %>"
                                type="number"
                                class="form-control"
                                min="1"
                                required
                            />
                            <div class="invalid-feedback">Please enter a valid price.</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 mb-3">
                        <label for="category" class="form-label">Category</label>
                        <select name="listing[category]" id="category" class="form-select">
                            <option value="Trending" <%= listing.category === 'Trending' ? 'selected' : '' %>>🔥 Trending</option>
                            <option value="Rooms" <%= listing.category === 'Rooms' ? 'selected' : '' %>>🛏️ Rooms</option>
                            <option value="Iconic Cities" <%= listing.category === 'Iconic Cities' ? 'selected' : '' %>>🏙️ Iconic Cities</option>
                            <option value="Mountains" <%= listing.category === 'Mountains' ? 'selected' : '' %>>⛰️ Mountains</option>
                            <option value="Castles" <%= listing.category === 'Castles' ? 'selected' : '' %>>🏰 Castles</option>
                            <option value="Amazing Pools" <%= listing.category === 'Amazing Pools' ? 'selected' : '' %>>🏊 Amazing Pools</option>
                            <option value="Camping" <%= listing.category === 'Camping' ? 'selected' : '' %>>⛺ Camping</option>
                            <option value="Farms" <%= listing.category === 'Farms' ? 'selected' : '' %>>🚜 Farms</option>
                            <option value="Arctic" <%= listing.category === 'Arctic' ? 'selected' : '' %>>❄️ Arctic</option>
                            <option value="Domes" <%= listing.category === 'Domes' ? 'selected' : '' %>>🛖 Domes</option>
                            <option value="Boats" <%= listing.category === 'Boats' ? 'selected' : '' %>>⛵ Boats</option>
                        </select>
                    </div>
                </div>

                <!-- Country & Location -->
                <div class="row">
                    <div class="col-12 col-md-7 mb-3">
                        <label for="location" class="form-label">City / Location</label>
                        <input
                            name="listing[location]"
                            id="location"
                            value="<%= listing.location %>"
                            type="text"
                            class="form-control"
                            required
                        />
                        <div class="invalid-feedback">Please enter a location.</div>
                    </div>

                    <div class="col-12 col-md-5 mb-3">
                        <label for="country" class="form-label">Country</label>
                        <input
                            name="listing[country]"
                            id="country"
                            value="<%= listing.country %>"
                            type="text"
                            class="form-control"
                            required
                        />
                        <div class="invalid-feedback">Please enter a country.</div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button class="btn btn-primary-custom flex-grow-1 py-2 fs-6">
                        <i class="fa-solid fa-check me-1"></i> Save Changes
                    </button>
                    <a href="/listings/<%= listing._id %>" class="btn btn-outline-custom px-4 py-2">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>