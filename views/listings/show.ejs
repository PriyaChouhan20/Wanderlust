<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center mt-2 mb-5">
    <div class="col-12 col-lg-10 col-xl-9">
        
        <!-- Header: Title & Subtitle -->
        <div class="mb-3">
            <h1 class="show-header-title"><%= listing.title %></h1>
            <div class="show-location-subtitle">
                <i class="fa-solid fa-location-dot text-danger"></i>
                <span><%= listing.location %>, <%= listing.country %></span>
                <% if (listing.category) { %>
                    <span class="badge bg-light text-dark border ms-2"><i class="fa-solid fa-tag me-1 text-danger"></i><%= listing.category %></span>
                <% } %>
            </div>
        </div>

        <!-- Hero Image Container -->
        <div class="show-hero-img-container mb-4">
            <img
                src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=1200&q=80' %>"
                class="show-hero-img"
                alt="<%= listing.title %>"
            />
        </div>

        <!-- Details Grid -->
        <div class="row g-4">
            <!-- Left Column: Host & Description -->
            <div class="col-12 col-md-7">
                <!-- Host Info Box -->
                <div class="host-info-card">
                    <div class="host-avatar">
                        <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : 'H' %>
                    </div>
                    <div class="host-details">
                        <h6>Hosted by <%= listing.owner ? listing.owner.username : "Anonymous Host" %></h6>
                        <p><i class="fa-solid fa-shield-halved text-success me-1"></i> Verified Wanderlust Host</p>
                    </div>
                </div>

                <!-- Description -->
                <div class="listing-desc-box">
                    <h5 class="fw-bold mb-2">About this space</h5>
                    <p class="text-secondary" style="white-space: pre-line;"><%= listing.description %></p>
                </div>

                <!-- Property Highlights -->
                <div class="py-3 border-bottom">
                    <h5 class="fw-bold mb-3">Location features</h5>
                    <div class="d-flex flex-column gap-2 text-secondary">
                        <div><i class="fa-solid fa-city me-2 text-danger"></i><strong>City:</strong> <%= listing.location %></div>
                        <div><i class="fa-solid fa-earth-americas me-2 text-danger"></i><strong>Country:</strong> <%= listing.country %></div>
                        <% if (listing.category) { %>
                            <div><i class="fa-solid fa-compass me-2 text-danger"></i><strong>Category:</strong> <%= listing.category %></div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Right Column: Price Card & Owner/Admin Controls -->
            <div class="col-12 col-md-5">
                <div class="price-box-card sticky-top" style="top: 6rem; z-index: 10;">
                    <div class="d-flex justify-content-between align-items-baseline mb-3">
                        <div>
                            <span class="price-amount">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></span>
                            <span class="text-secondary"> / night</span>
                        </div>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Available</span>
                    </div>

                    <div class="border rounded-3 p-3 bg-light mb-3 small">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-secondary">Base rate</span>
                            <span>&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></span>
                        </div>
                        <div class="d-flex justify-content-between text-secondary">
                            <span>Taxes & fees</span>
                            <span>Calculated at checkout</span>
                        </div>
                    </div>

                    <!-- Edit & Delete Buttons (For Listing Owner or Admin ONLY) -->
                    <% if (currUser && (currUser.role === "admin" || (listing.owner && currUser._id.equals(listing.owner._id || listing.owner)))) { %>
                        <div class="action-btn-group pt-2 border-top">
                            <a
                                href="/listings/<%= listing._id %>/edit"
                                class="btn btn-outline-custom flex-grow-1"
                            >
                                <i class="fa-regular fa-pen-to-square"></i> Edit Listing
                            </a>

                            <form
                                method="POST"
                                action="/listings/<%= listing._id %>?_method=DELETE"
                                class="flex-grow-1"
                            >
                                <button type="submit" class="btn btn-dark-custom w-100" onclick="return confirm('Are you sure you want to delete this listing?');">
                                    <i class="fa-regular fa-trash-can"></i> Delete
                                </button>
                            </form>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <!-- Reviews Section -->
        <div class="my-4">
            <h3 class="fw-bold mb-3"><i class="fa-solid fa-star text-danger me-2"></i> Reviews & Ratings</h3>

            <!-- Leave Review Form (If Logged In) -->
            <% if (currUser) { %>
                <div class="review-form-card mb-4">
                    <h5 class="fw-bold mb-3">Leave a Review</h5>
                    <form
                        method="POST"
                        action="/listings/<%= listing._id %>/reviews"
                        novalidate
                        class="needs-validation"
                    >
                        <!-- Rating Stars -->
                        <div class="mb-3">
                            <label class="form-label d-block">Overall Rating</label>
                            <fieldset class="starability-slot">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>

                        <!-- Comment Textarea -->
                        <div class="mb-3">
                            <label for="comment" class="form-label">Your Feedback</label>
                            <textarea
                                name="review[comment]"
                                id="comment"
                                cols="30"
                                rows="3"
                                class="form-control"
                                placeholder="Tell others about your experience, the amenities, and host communication..."
                                required
                            ></textarea>
                            <div class="invalid-feedback">
                                Please write a short comment before submitting.
                            </div>
                        </div>

                        <button class="btn btn-dark-custom">
                            <i class="fa-solid fa-paper-plane me-1"></i> Submit Review
                        </button>
                    </form>
                </div>
            <% } %>

            <!-- All Reviews List -->
            <% if (listing.reviews && listing.reviews.length > 0) { %>
                <div class="row row-cols-1 row-cols-md-2 g-3">
                    <% for (let review of listing.reviews) { %>
                        <div class="col">
                            <div class="review-item-card">
                                <div>
                                    <div class="review-author-info">
                                        <div class="review-avatar">
                                            <%= review.author && review.author.username ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                                        </div>
                                        <div>
                                            <div class="review-author-name">@<%= review.author ? review.author.username : "Anonymous" %></div>
                                            <p class="starability-result m-0" data-rating="<%= review.rating %>">
                                                Rated: <%= review.rating %> stars
                                            </p>
                                        </div>
                                    </div>
                                    <p class="text-secondary mt-2 mb-3" style="font-size: 0.93rem;">
                                        "<%= review.comment %>"
                                    </p>
                                </div>

                                <% if (currUser && (currUser.role === "admin" || (review.author && currUser._id.equals(review.author._id || review.author)))) { %>
                                    <form
                                        class="mt-2 text-end"
                                        method="POST"
                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                    >
                                        <button class="btn btn-sm btn-outline-danger border-0" onclick="return confirm('Delete this review?');">
                                            <i class="fa-regular fa-trash-can me-1"></i> Delete
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <p class="text-muted">No reviews yet. Be the first to leave a review!</p>
            <% } %>
        </div>

        <hr class="my-4" />

        <!-- Map Section -->
        <div class="my-4">
            <h3 class="fw-bold mb-1"><i class="fa-solid fa-map-location-dot text-danger me-2"></i> Where you'll be</h3>
            <p class="text-secondary"><%= listing.location %>, <%= listing.country %></p>
            <div id="map"></div>
        </div>

    </div>
</div>

<!-- Mapbox Data & Script -->
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listingLocation = <%- JSON.stringify(listing.location || "") %>;
    const listingTitle = <%- JSON.stringify(listing.title || "") %>;
</script>
<script src="/js/map.js"></script>
