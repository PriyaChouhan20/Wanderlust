<% layout("/layouts/boilerplate") %>

<div id="filters">
    <div class="filter-wrapper">
        <a href="/listings?category=Trending" class="filter <%= typeof category !== 'undefined' && category === 'Trending' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </a>
        <a href="/listings?category=Rooms" class="filter <%= typeof category !== 'undefined' && category === 'Rooms' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </a>
        <a href="/listings?category=Iconic Cities" class="filter <%= typeof category !== 'undefined' && category === 'Iconic Cities' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic Cities</p>
        </a>
        <a href="/listings?category=Mountains" class="filter <%= typeof category !== 'undefined' && category === 'Mountains' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </a>
        <a href="/listings?category=Castles" class="filter <%= typeof category !== 'undefined' && category === 'Castles' ? 'active-filter' : '' %>">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </a>
        <a href="/listings?category=Amazing Pools" class="filter <%= typeof category !== 'undefined' && category === 'Amazing Pools' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
        </a>
        <a href="/listings?category=Camping" class="filter <%= typeof category !== 'undefined' && category === 'Camping' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </a>
        <a href="/listings?category=Farms" class="filter <%= typeof category !== 'undefined' && category === 'Farms' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </a>
        <a href="/listings?category=Arctic" class="filter <%= typeof category !== 'undefined' && category === 'Arctic' ? 'active-filter' : '' %>">
            <div><i class="fa-regular fa-snowflake"></i></div>
            <p>Arctic</p>
        </a>
        <a href="/listings?category=Domes" class="filter <%= typeof category !== 'undefined' && category === 'Domes' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p>Domes</p>
        </a>
        <a href="/listings?category=Boats" class="filter <%= typeof category !== 'undefined' && category === 'Boats' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-ship"></i></div>
            <p>Boats</p>
        </a>
    </div>

    <!-- Tax Toggle -->
    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="taxSwitch">
            <label class="form-check-label" for="taxSwitch">Display total after taxes</label>
        </div>
    </div>
</div>

<% if (typeof search !== 'undefined' && search) { %>
    <div class="mt-2 mb-3 d-flex align-items-center justify-content-between">
        <h5>Search results for: <i>"<%= search %>"</i></h5>
        <a href="/listings" class="btn btn-sm btn-outline-dark">Clear Search</a>
    </div>
<% } else if (typeof category !== 'undefined' && category) { %>
    <div class="mt-2 mb-3 d-flex align-items-center justify-content-between">
        <h5>Category: <i>"<%= category %>"</i></h5>
        <a href="/listings" class="btn btn-sm btn-outline-dark">Show All</a>
    </div>
<% } %>

<% if (allListings.length === 0) { %>
    <div class="col-6 offset-3 text-center my-5">
        <h4>No listings found!</h4>
        <p class="text-secondary">Try searching for something else or browse all destinations.</p>
        <a href="/listings" class="btn btn-dark mt-2">View All Listings</a>
    </div>
<% } else { %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 mt-1">
        <% for(let listing of allListings) { %>
            <div class="col">
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card h-100">
                        <img
                            src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=60' %>"
                            class="card-img-top"
                            alt="listing_image"
                        />
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <p class="card-text">
                                <b><%= listing.title %></b><br>
                                <span class="base-price">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></span> / night
                                <i class="tax-info text-secondary">&nbsp; +18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>
<% } %>

<script>
    const taxSwitch = document.getElementById("taxSwitch");
    if (taxSwitch) {
        taxSwitch.addEventListener("click", () => {
            const taxInfo = document.getElementsByClassName("tax-info");
            for (let info of taxInfo) {
                if (info.style.display !== "inline") {
                    info.style.display = "inline";
                } else {
                    info.style.display = "none";
                }
            }
        });
    }
</script>