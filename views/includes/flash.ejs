<div class="flash-alert-container">
    <% if (success && success.length) { %>
        <div class="alert alert-success custom-alert alert-dismissible fade show mb-3" role="alert">
            <i class="fa-solid fa-circle-check fs-5"></i>
            <div class="flex-grow-1"><%= success %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (error && error.length) { %>
        <div class="alert alert-danger custom-alert alert-dismissible fade show mb-3" role="alert">
            <i class="fa-solid fa-triangle-exclamation fs-5"></i>
            <div class="flex-grow-1"><%= error %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
</div>
