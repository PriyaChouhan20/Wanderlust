<nav class="navbar navbar-expand-md navbar-custom sticky-top">
  <div class="container-fluid px-md-4">
    <!-- Brand Logo -->
    <a class="brand-logo me-3" href="/listings">
      <i class="fa-solid fa-compass"></i>
      <span class="brand-name">Wanderlust</span>
    </a>

    <!-- Mobile Toggler Button -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Collapsible Menu -->
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <!-- Search Bar -->
      <div class="search-form-container mx-md-auto">
        <form class="search-pill-wrapper" role="search" action="/listings" method="GET">
          <input
            class="search-pill-input"
            type="search"
            name="search"
            placeholder="Search destinations..."
            aria-label="Search"
            value="<%= typeof search !== 'undefined' && search ? search : '' %>"
          />
          <button class="search-pill-btn" type="submit" title="Search">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        </form>
      </div>

      <!-- Right Navigation / Auth Links -->
      <div class="navbar-nav ms-md-auto align-items-md-center gap-1 mt-2 mt-md-0">
        <a class="nav-link-custom nav-host-btn" href="/listings/new">
          <i class="fa-solid fa-house-chimney me-1 text-danger"></i> Airbnb your home
        </a>

        <% if (!currUser) { %>
          <a class="nav-link-custom" href="/signup">Sign up</a>
          <a class="nav-link-custom" href="/login"><b>Log in</b></a>
        <% } else { %>
          <div class="d-flex align-items-center flex-wrap gap-2 my-1 my-md-0">
            <span class="user-pill-badge">
              <span class="user-avatar-circle"><%= currUser.username ? currUser.username.charAt(0).toUpperCase() : 'U' %></span>
              <span><%= currUser.username %></span>
              <% if (currUser.role === "admin") { %>
                <span class="admin-tag">Admin</span>
              <% } %>
            </span>
            <a class="nav-link-custom text-danger" href="/logout" title="Log out">
              <i class="fa-solid fa-arrow-right-from-bracket"></i>
              <span class="d-md-none ms-1">Log out</span>
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>